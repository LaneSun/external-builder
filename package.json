{
  "name": "external-builder",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "compile": "deno compile -o dist/external-builder-linux.x86_64 -A --no-check --include ./build/client/ ./build/index.js",
    "compile-win": "deno compile -o dist/external-builder-win64.exe -A --no-check --include ./build/client/ --target x86_64-pc-windows-msvc ./build/index.js"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/typography": "^0.5.18",
    "@tailwindcss/vite": "^4.1.13",
    "@types/deno": "^2.5.0",
    "@types/node": "^24.5.0",
    "lucide-svelte": "^0.546.0",
    "mode-watcher": "^1.1.0",
    "rakiyu-deno-kv": "^0.12.102",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
